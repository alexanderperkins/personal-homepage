    "@eslint/js": "^9.18.0",
    "eslint": "^9.39.4",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^15.14.0",
    "prettier": "^3.8.3",
    "serve": "^14.2.4"
  }
}
