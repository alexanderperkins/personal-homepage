{
  "name": "personal-homepage",
  "version": "1.0.0",
  "type": "module",
  "description": "Personal homepage — a clean, minimal static site built with vanilla HTML5, CSS3, and ES6 modules.",
  "main": "index.html",
  "scripts": {
    "lint": "eslint js/**/*.js",
    "format": "prettier --write \"**/*.{html,css,js}\"",
